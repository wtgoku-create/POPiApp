[Unit]
Description=POPi test environment access gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=popi-access
Group=popi-access
WorkingDirectory=/opt/popi-harness/current
Environment=POPI_ACCESS_ORIGIN=https://124.222.185.31
ExecStart=/opt/popi-harness/node/bin/node /opt/popi-harness/current/deploy/harness/auth-gateway.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
