[Unit]
Description=POPi isolated legacy Office document converter
After=local-fs.target

[Service]
Type=simple
User=popi-document-converter
Group=popi-harness
RuntimeDirectory=popi-document-converter
RuntimeDirectoryMode=0750
StateDirectory=popi-document-converter
StateDirectoryMode=0700
WorkingDirectory=/var/lib/popi-document-converter
Environment=HOME=/var/lib/popi-document-converter
Environment=PATH=/opt/popi-harness/node/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /opt/popi-harness/current/services/agent/local/document-converter-daemon.py --socket /run/popi-document-converter/convert.sock
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
InaccessiblePaths=/etc/popi-harness /var/lib/popi-harness
ReadWritePaths=/var/lib/popi-document-converter /run/popi-document-converter
MemoryMax=1G
MemorySwapMax=768M
CPUQuota=100%
TasksMax=64
LimitFSIZE=67108864

[Install]
WantedBy=multi-user.target
