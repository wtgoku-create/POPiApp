[Unit]
Description=POPi single-user test Harness
After=network-online.target popi-document-converter.service
Wants=network-online.target popi-document-converter.service

[Service]
Type=simple
User=popi-harness
Group=popi-harness
WorkingDirectory=/opt/popi-harness/current
EnvironmentFile=/etc/popi-harness/service.env
ExecStart=/opt/popi-harness/node/bin/node /opt/popi-harness/current/deploy/harness/server.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/popi-harness
MemoryMax=3G
CPUQuota=200%
TasksMax=256

[Install]
WantedBy=multi-user.target
