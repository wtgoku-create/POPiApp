{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "POPi: run",
      "type": "process",
      "command": "dart",
      "osx": {"command": "${env:HOME}/SDK/flutter/bin/dart"},
      "args": ["run", "tool/flutter_env.dart", "development", "run"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "POPi: build iOS simulator",
      "type": "process",
      "command": "dart",
      "osx": {"command": "${env:HOME}/SDK/flutter/bin/dart"},
      "args": ["run", "tool/flutter_env.dart", "development", "build", "ios", "--simulator"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "POPi: build APK",
      "type": "process",
      "command": "dart",
      "osx": {"command": "${env:HOME}/SDK/flutter/bin/dart"},
      "args": ["run", "tool/flutter_env.dart", "development", "build", "apk", "--release"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "POPi: build IPA",
      "type": "process",
      "command": "dart",
      "osx": {"command": "${env:HOME}/SDK/flutter/bin/dart"},
      "args": ["run", "tool/flutter_env.dart", "development", "build", "ipa", "--release"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "POPi: prepare production",
      "type": "process",
      "command": "dart",
      "osx": {"command": "${env:HOME}/SDK/flutter/bin/dart"},
      "args": ["run", "tool/flutter_env.dart", "production", "prepare"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "POPi: prepare development",
      "type": "process",
      "command": "dart",
      "osx": {"command": "${env:HOME}/SDK/flutter/bin/dart"},
      "args": ["run", "tool/flutter_env.dart", "development", "prepare"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
