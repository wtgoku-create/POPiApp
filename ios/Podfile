platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  pod 'DouyinOpenSDK', '4.2.5'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  wechat_sdk = installer.pod_targets.find { |target| target.name == 'WechatOpenSDK-XCFramework' }
  douyin_sdk = installer.pod_targets.find { |target| target.name == 'DouyinOpenSDK' }
  simulator_sdk_targets = []
  simulator_sdk_targets << 'WechatOpenSDK-XCFramework' if wechat_sdk && wechat_sdk.root_spec.version.to_s == '2.0.7'
  simulator_sdk_targets << 'DouyinOpenSDK' if douyin_sdk && douyin_sdk.root_spec.version.to_s == '4.2.5'

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    if simulator_sdk_targets.include?(target.name) ||
       (!simulator_sdk_targets.empty? && target.name.start_with?('Pods-Runner'))
      # WeChat has an arm64 simulator slice; Douyin is linked only on devices below.
      target.build_configurations.each do |config|
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'
      end
    end
  end

  installer.aggregate_targets.each do |target|
    target.xcconfigs.each do |name, config|
      config.attributes['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386' unless simulator_sdk_targets.empty?
      if simulator_sdk_targets.include?('DouyinOpenSDK') && config.frameworks.include?('DouyinOpenSDK')
        # Conditional flags inherit the default flags, so add this SDK only for devices.
        config.frameworks.delete('DouyinOpenSDK')
        config.attributes['OTHER_LDFLAGS[sdk=iphoneos*]'] = '$(inherited) -framework "DouyinOpenSDK"'
      end
      config.save_as(target.xcconfig_path(name))
    end
  end
end
